# =============================================================
# 电商看板 Text-to-SQL 双 Agent —— 环境变量模板
# 复制为 .env 后填写实际值：
#   cp .env.example .env   (Windows: copy .env.example .env)
# =============================================================

# ---------- LLM（Agent 大脑） ----------
# provider: deepseek=真实模型 | mock=本地确定性模拟（无 Key 调试用）
LLM_PROVIDER=deepseek
# ★ 必填：DeepSeek API Key（https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 以 DeepSeek 官方当前实际可用的模型名为准（deepseek-chat / deepseek-reasoner 等）
DEEPSEEK_MODEL=deepseek-chat
# SQL 生成温度（低=更确定）
LLM_TEMPERATURE=0

# ---------- RAG ----------
# 检索 Top-N 模板注入提示词（few-shot 数量，太多费 token）
RAG_TOP_K=4

# ---------- MySQL（只读执行层） ----------
# 生产规范：使用只读账号 agent_ro（见 README「安全三层防线」授权 SQL）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=ecommerce

# ---------- Redis（记忆/缓存/限流） ----------
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- PostgreSQL（历史对话归档，可选） ----------
# 存"永久历史"（回放/审计）；Redis 只存"短期工作记忆"（指代消解）。
# 不可达时历史功能自动降级（对话主链路不受影响）。
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DB=rag_db

# ---------- Milvus（SQL 模板向量库，部署在虚拟机的 Docker） ----------
# 虚拟机开机后，把 HOST 改为虚拟机 IP 即自动启用；不可达时降级本地向量检索
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=sql_templates
# 不可达时是否自动降级本地实现（true=降级，false=直接报错）
MILVUS_USE_LOCAL_FALLBACK=true

# ---------- 业务与安全 ----------
MAX_ROWS=1000
QUERY_TIMEOUT=10
SESSION_TTL=86400
SQL_CACHE_TTL=300
RATE_LIMIT=30
SQL_RETRY_TIMES=3

# ---------- 数据时间锚点（可选） ----------
# 留空=自动取数据中最大 order_time（推荐）；如需固定演示日期可填，如 2026-12-31
DATA_ANCHOR_OVERRIDE=
