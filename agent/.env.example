# =============================================================
# 电商看板 Text-to-SQL Agent —— 环境变量模板
# 复制为 .env 后填写：cp .env.example .env
# =============================================================

# ---------- LLM（Agent 大脑） ----------
# provider: deepseek=任意 OpenAI 兼容端点 | mock=本地确定性模拟（无 Key 调试用）
# 只要兼容 /chat/completions 就能接：DeepSeek 官方、阿里云百炼、vLLM、Ollama…
# 本项目实测用阿里云百炼（DeepSeek 官方余额不足时的等价替换）：
#   DEEPSEEK_BASE_URL=https://ws-xxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#   DEEPSEEK_MODEL=deepseek-v4.1-flash-1017
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0

# ---------- Embedding（BGE-M3，1024 维） ----------
# 用 SiliconFlow 的 OpenAI 兼容接口；也可换阿里百炼/OpenAI，只需改 base_url + model + dim
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
# embedding 磁盘缓存目录（重复灌库不重复付费）
EMBEDDING_CACHE_DIR=.cache/embeddings

# ---------- Rerank（精排，可关闭） ----------
RERANK_ENABLED=true
RERANK_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=12

# ---------- RAG 检索参数 ----------
RAG_TOP_K=8
RAG_DENSE_TOP_K=50
RAG_SPARSE_TOP_K=50
RAG_FUSION_TOP_K=30
RRF_K=60
MMR_LAMBDA=0.7
RAG_QUOTA_TEMPLATES=3
RAG_QUOTA_SCHEMA=2
RAG_QUOTA_GLOSSARY=2
RAG_QUOTA_FEWSHOT=1

# ---------- MySQL（只读执行层） ----------
# 生产规范：使用只读账号 agent_ro（见 README「安全三层防线」）授 SELECT
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=ecommerce

# ---------- Redis（记忆/缓存/限流） ----------
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- PostgreSQL（历史对话归档，可选） ----------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DB=rag_db

# ---------- Milvus（知识库向量存储） ----------
MILVUS_HOST=192.168.96.129
MILVUS_PORT=19530
MILVUS_COLLECTION=agent_knowledge
MILVUS_COLLECTION_VERSION=1
MILVUS_ALIAS=agent_knowledge
MILVUS_HNSW_M=16
MILVUS_EF_CONSTRUCTION=200
MILVUS_SEARCH_EF=64
MILVUS_USE_LOCAL_FALLBACK=true

# ---------- 业务与安全 ----------
MAX_ROWS=1000
QUERY_TIMEOUT=10
SESSION_TTL=86400
SQL_CACHE_TTL=300
RATE_LIMIT=30
SQL_RETRY_TIMES=3
# 前端跨域白名单，逗号分隔；本地开发可用 *
CORS_ORIGINS=*

# ---------- 数据时间锚点（可选） ----------
# 留空=自动取数据中最大 order_time（推荐）；如需固定演示日期可填，如 2026-12-31
DATA_ANCHOR_OVERRIDE=